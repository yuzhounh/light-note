<Window x:Class="LightNote.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LightNote.App"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="LightNote"
        Icon="Assets/pen-note-icon-yellow.ico"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="560"
        FontFamily="Microsoft YaHei"
        Background="{DynamicResource AppBackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Find" Executed="OnFindExecuted" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewNoteCommand}" />
        <KeyBinding Key="N" Modifiers="Control+Shift" Command="{Binding NewNotebookCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="ApplicationCommands.Find" />
    </Window.InputBindings>
    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="16,10" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="AccountButton" Click="OnSyncClick" ToolTip="Google 账户与同步"
                            AutomationProperties.Name="Google 登录和同步">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="AccountAvatar" Width="24" Height="24" CornerRadius="12"
                                    Background="{DynamicResource AccentLightBrush}">
                                <TextBlock x:Name="AccountAvatarText" Text="G" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="AccountButtonText" Margin="7,0,0,0" Text="Google 登录"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsMenuButton" Content="设置 ▾" Click="OnSettingsMenuButtonClick"
                            ToolTip="应用设置和数据工具" AutomationProperties.Name="打开设置菜单">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="导入 / 迁移" Click="OnImportClick" />
                                <Separator />
                                <MenuItem Header="备份" Click="OnBackupClick" />
                                <MenuItem Header="恢复备份" Click="OnRestoreBackupClick" />
                                <MenuItem Header="数据安全" Click="OnDataSafetyClick" />
                                <Separator />
                                <MenuItem Header="应用设置" Click="OnSettingsClick" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NotebookColumn" Width="220" MinWidth="170" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition x:Name="NoteListColumn" Width="300" MinWidth="230" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Padding="12" Background="{DynamicResource SecondaryPanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Button DockPanel.Dock="Top" Height="52" Margin="0,0,0,14"
                            Padding="7,5" HorizontalContentAlignment="Stretch"
                            Background="{DynamicResource PanelBrush}" BorderThickness="0"
                            Command="{Binding NewNoteCommand}" ToolTip="新建笔记（Ctrl+N）"
                            AutomationProperties.Name="新建笔记">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="NewNoteButtonBorder" CornerRadius="26"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="NewNoteButtonBorder" Property="Background"
                                                Value="{DynamicResource AccentLightBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="NewNoteButtonBorder" Property="Opacity" Value="0.82" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="38" Height="38" CornerRadius="19" Background="#FF00B87A"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="＋" FontSize="26" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="新建笔记"
                                       FontSize="16" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Grid DockPanel.Dock="Top" Margin="8,8,2,12">
                        <TextBlock Text="视图、笔记本与标签" Foreground="{StaticResource MutedTextBrush}"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right" Padding="7,2" Margin="0" Content="＋"
                                Click="OnNewNotebookClick" ToolTip="新建笔记本（Ctrl+Shift+N）" />
                    </Grid>
                    <ListBox ItemsSource="{Binding Notebooks}" SelectedItem="{Binding SelectedNotebook}"
                             DisplayMemberPath="DisplayName" BorderThickness="0"
                             Background="Transparent" FontSize="14">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="7,6" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}" DragCompleted="OnPaneSplitterDragCompleted" />
            <Border Grid.Column="2" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="14,12" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel>
                            <Border CornerRadius="6" Background="{DynamicResource SecondaryPanelBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <TextBox x:Name="SearchBox" Margin="10,7" BorderThickness="0" Background="Transparent"
                                             FontSize="14" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="搜索标题和正文（Ctrl+F）" />
                                    <TextBlock Margin="12,0" Text="搜索标题和正文" VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedTextBrush}" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                            <TextBlock Margin="2,12,0,0" Text="{Binding NotesHeading}" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Button DockPanel.Dock="Bottom" Margin="14,8" Padding="12,7"
                            Content="加载更多笔记" Command="{Binding LoadMoreCommand}"
                            Visibility="{Binding HasMoreNotes, Converter={StaticResource BooleanToVisibilityConverter}}"
                            AutomationProperties.Name="加载更多笔记" />
                    <Grid>
                        <ListBox ItemsSource="{Binding Notes}" SelectedItem="{Binding SelectedNote}"
                                 BorderThickness="0" Background="{DynamicResource PanelBrush}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnNotePreviewMouseRightButtonDown" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="ContextMenu">
                                        <Setter.Value>
                                            <ContextMenu Opened="OnNoteContextMenuOpened">
                                                <MenuItem Header="置顶 / 取消置顶" Tag="normal" Click="OnTogglePinMenuClick" />
                                                <MenuItem Header="移动到笔记本…" Tag="normal" Click="OnMoveNoteClick" />
                                                <MenuItem Header="编辑标签…" Tag="normal" Click="OnEditTagsClick" />
                                                <MenuItem Header="历史版本…" Click="OnHistoryClick" />
                                                <MenuItem Header="导出…" Click="OnExportNoteClick" />
                                                <Separator Tag="normal" />
                                                <MenuItem Header="移到回收站" Tag="normal" Click="OnDeleteNoteMenuClick" />
                                                <MenuItem Header="恢复笔记" Tag="trash" Click="OnRestoreNoteMenuClick" />
                                                <MenuItem Header="永久删除" Tag="trash" Click="OnPermanentDeleteClick" />
                                            </ContextMenu>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="250" Margin="8,10">
                                        <local:HighlightedTextBlock HighlightText="{Binding TitleDisplay}"
                                                                    HighlightQuery="{Binding MatchQuery}"
                                                                    FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <local:HighlightedTextBlock Margin="0,5,0,0" HighlightText="{Binding Preview}"
                                                                    HighlightQuery="{Binding MatchQuery}"
                                                                    Foreground="{StaticResource MutedTextBrush}"
                                                                    TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,5,0,0" Text="{Binding UpdatedLabel}" FontSize="11"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border Background="{DynamicResource PanelBrush}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasNotes}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="这里还没有笔记" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Margin="0,6,0,12" Text="创建一篇笔记开始记录" Foreground="{StaticResource MutedTextBrush}" />
                                <Button Content="新建笔记" Command="{Binding NewNoteCommand}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="3" Width="1" HorizontalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}" DragCompleted="OnPaneSplitterDragCompleted" />
            <Grid Grid.Column="4" Background="{DynamicResource PanelBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="82" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="1" Padding="24,14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <StackPanel IsEnabled="{Binding IsEditorEnabled}">
                        <TextBox Text="{Binding EditableTitle, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="22" FontWeight="SemiBold" BorderThickness="0" Padding="0"
                                 Background="Transparent" TextWrapping="NoWrap" />
                        <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                            <TextBlock Text="V1.0 数据可靠版" Foreground="{StaticResource MutedTextBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Margin="14,0,0,0" Text="{Binding SelectedTagsDisplay}"
                                       Foreground="{StaticResource AccentBrush}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Padding="12,7" Background="Transparent"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                        IsEnabled="{Binding IsEditorEnabled}">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="FontFamilyBox" Width="150" Margin="4,0" Padding="6,3"
                                      SelectedIndex="0" SelectionChanged="OnEditorFontFamilyChanged"
                                      ToolTip="字体">
                                <ComboBoxItem Content="微软雅黑" Tag="Microsoft YaHei" />
                                <ComboBoxItem Content="宋体" Tag="SimSun" />
                                <ComboBoxItem Content="黑体" Tag="SimHei" />
                            </ComboBox>
                            <ComboBox x:Name="FontSizeBox" Width="62" Margin="2,0,4,0" Padding="6,3"
                                      SelectedIndex="0" SelectionChanged="OnEditorFontSizeChanged"
                                      ToolTip="字号">
                                <ComboBoxItem Content="12" Tag="12" />
                                <ComboBoxItem Content="14" Tag="14" />
                                <ComboBoxItem Content="16" Tag="16" />
                                <ComboBoxItem Content="18" Tag="18" />
                                <ComboBoxItem Content="24" Tag="24" />
                                <ComboBoxItem Content="32" Tag="32" />
                            </ComboBox>
                            <Button x:Name="ParagraphButton" Padding="8,4" Content="正文" Tag="paragraph"
                                    Click="OnEditorCommandClick" ToolTip="正文" />
                            <Button x:Name="Heading1Button" Padding="8,4" Content="标题 1" Tag="heading1"
                                    Click="OnEditorCommandClick" ToolTip="一级标题" />
                            <Button x:Name="Heading2Button" Padding="8,4" Content="标题 2" Tag="heading2"
                                    Click="OnEditorCommandClick" ToolTip="二级标题" />
                            <Separator Margin="5,0" />
                            <Button x:Name="BoldButton" Width="34" Padding="6,4" Content="B" FontWeight="Bold" Tag="bold"
                                    Click="OnEditorCommandClick" ToolTip="粗体" />
                            <Button x:Name="ItalicButton" Width="34" Padding="6,4" Content="I" FontStyle="Italic" Tag="italic"
                                    Click="OnEditorCommandClick" ToolTip="斜体" />
                            <Button x:Name="UnderlineButton" Width="34" Padding="6,4" Content="U̲" Tag="underline"
                                    Click="OnEditorCommandClick" ToolTip="下划线（Ctrl+U）" />
                            <Button x:Name="StrikeButton" Width="34" Padding="6,4" Content="S̶" Tag="strike"
                                    Click="OnEditorCommandClick" ToolTip="删除线" />
                            <Button x:Name="HighlightButton" Width="34" Padding="6,4" Content="▰" Tag="highlight"
                                    Click="OnEditorCommandClick" ToolTip="文字高亮" />
                            <Button x:Name="InlineCodeButton" Width="38" Padding="6,4" Content="{}{ }" Tag="inlineCode"
                                    Click="OnEditorCommandClick" ToolTip="行内代码" />
                            <Separator Margin="5,0" />
                            <Button x:Name="BulletListButton" Padding="8,4" Content="• 列表" Tag="bulletList"
                                    Click="OnEditorCommandClick" ToolTip="项目符号列表" />
                            <Button x:Name="OrderedListButton" Padding="8,4" Content="1. 列表" Tag="orderedList"
                                    Click="OnEditorCommandClick" ToolTip="编号列表" />
                            <Button x:Name="QuoteButton" Padding="8,4" Content="引用" Tag="blockquote"
                                    Click="OnEditorCommandClick" ToolTip="引用" />
                            <Button x:Name="CodeBlockButton" Padding="8,4" Content="代码" Tag="codeBlock"
                                    Click="OnEditorCommandClick" ToolTip="代码块" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                <Border Grid.Row="2" Margin="18,10,18,18" BorderThickness="0" Background="Transparent">
                    <wv2:WebView2 x:Name="EditorWebView" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
