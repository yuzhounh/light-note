<Window x:Class="LightNote.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LightNote.App"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="LightNote"
        Icon="Assets/pen-note-icon-yellow.ico"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="560"
        FontFamily="Microsoft YaHei"
        Background="{DynamicResource AppBackgroundBrush}"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="8" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="PaneGridSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Width" Value="7" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBrush}" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="ResizeDirection" Value="Columns" />
            <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="3" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{TemplateBinding Background}" />
                            <Border x:Name="DividerLine" Grid.Column="1" Width="1"
                                    Panel.ZIndex="1" HorizontalAlignment="Center"
                                    Background="{DynamicResource BorderBrush}" />
                            <Border Grid.Column="2" Background="{TemplateBinding BorderBrush}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DividerLine" Property="Width" Value="3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccountPopupItemButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ItemBackground" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBackground" Property="Background"
                                        Value="{DynamicResource SecondaryPanelBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ItemBackground" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccountThemeMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Padding="6" CornerRadius="10"
                                Background="{DynamicResource PanelBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Find" Executed="OnFindExecuted" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewNoteCommand}" />
        <KeyBinding Key="N" Modifiers="Control+Shift" Command="{Binding NewNotebookCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="ApplicationCommands.Find" />
    </Window.InputBindings>
    <Border Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            SnapsToDevicePixels="True">
    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <local:WindowTitleBar />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NotebookColumn" Width="220" MinWidth="170" />
                <ColumnDefinition Width="7" />
                <ColumnDefinition x:Name="NoteListColumn" Width="300" MinWidth="230" />
                <ColumnDefinition Width="7" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>
            <Border x:Name="SidebarPanel" Grid.Column="0" Padding="12"
                    Background="{DynamicResource SecondaryPanelBrush}">
                <Border.ContextMenu>
                    <ContextMenu Opened="OnSidebarContextMenuOpened">
                        <MenuItem Header="新建笔记本" Click="OnNewNotebookClick" />
                        <MenuItem Header="新建笔记本组" Click="OnNewNotebookGroupClick" />
                        <Separator Style="{StaticResource MenuSeparatorStyle}" />
                        <MenuItem Header="最近笔记" Tag="navigation:recent" IsCheckable="True"
                                  Click="OnNavigationMenuItemClick" />
                        <MenuItem Header="置顶笔记" Tag="navigation:pinned" IsCheckable="True"
                                  Click="OnNavigationMenuItemClick" />
                        <MenuItem Header="回收站" Tag="navigation:trash" IsCheckable="True"
                                  Click="OnNavigationMenuItemClick" />
                    </ContextMenu>
                </Border.ContextMenu>
                <DockPanel>
                    <Button DockPanel.Dock="Top" Height="46" Margin="0,0,0,14"
                            Padding="0" HorizontalContentAlignment="Stretch"
                            Background="{DynamicResource PanelBrush}" BorderThickness="0"
                            Command="{Binding NewNoteCommand}" ToolTip="新建笔记（Ctrl+N）"
                            AutomationProperties.Name="新建笔记">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="NewNoteButtonBorder" CornerRadius="23"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="NewNoteButtonBorder" Property="Background"
                                                Value="{DynamicResource AccentLightBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="NewNoteButtonBorder" Property="Opacity" Value="0.82" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="16" Background="#FF00B87A"
                                    Margin="7,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Path Data="M 7,0 V 14 M 0,7 H 14" Width="14" Height="14"
                                      Stroke="White" StrokeThickness="2.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="新建笔记"
                                       FontSize="16" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Padding="0,12,0,0"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                        <Grid x:Name="SidebarFooter">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="38" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="AccountButton" Margin="0,0,4,0" Padding="6,6"
                                    Style="{StaticResource SidebarActionButtonStyle}"
                                    HorizontalContentAlignment="Left" Click="OnAccountButtonClick"
                                    ToolTip="账户与同步" AutomationProperties.Name="打开账户菜单">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="24" Height="24" CornerRadius="6"
                                            Background="{DynamicResource SecondaryPanelBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Margin="0,0,8,0">
                                        <Grid>
                                            <TextBlock x:Name="SidebarAvatarInitial" Text="" Visibility="Collapsed"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" />
                                            <Image x:Name="SidebarAvatarImage" Stretch="UniformToFill">
                                                <Image.Clip>
                                                    <RectangleGeometry Rect="0,0,24,24" RadiusX="6" RadiusY="6" />
                                                </Image.Clip>
                                            </Image>
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="AccountButtonText" Grid.Column="1" Text="Google 登录"
                                               FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button Grid.Column="1" Margin="0" Padding="0"
                                    Style="{StaticResource SidebarActionButtonStyle}"
                                    HorizontalContentAlignment="Center"
                                    Click="OnSettingsClick" ToolTip="设置"
                                    AutomationProperties.Name="打开设置">
                                <TextBlock FontFamily="Segoe Fluent Icons" FontSize="17"
                                           Foreground="{DynamicResource TextBrush}" Text="&#xE713;" />
                            </Button>
                            <Popup x:Name="AccountPopup" Grid.ColumnSpan="2"
                                   Placement="Top" PlacementTarget="{Binding ElementName=SidebarFooter}"
                                   HorizontalOffset="0" VerticalOffset="-8"
                                   StaysOpen="False" AllowsTransparency="True"
                                   PopupAnimation="Fade">
                                <Border x:Name="AccountPopupCard" Padding="10" CornerRadius="12"
                                        Background="{DynamicResource PanelBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270"
                                                          Opacity="0.35" Color="#000000" />
                                    </Border.Effect>
                                    <StackPanel>
                                        <!-- Header with Name, Email and Avatar -->
                                        <Grid Margin="10,8,10,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="AccountPopupDisplayNameText" FontSize="16"
                                                           FontWeight="Bold" Text="Google 账户" TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:Name="AccountPopupEmailText" Margin="0,3,0,0" FontSize="13"
                                                           Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Width="40" Height="40" CornerRadius="8"
                                                    Background="{DynamicResource SecondaryPanelBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Grid>
                                                    <TextBlock x:Name="AccountPopupAvatarInitial" Text="" Visibility="Collapsed"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               FontSize="16" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" />
                                                    <Image x:Name="AccountPopupAvatarImage" Stretch="UniformToFill">
                                                        <Image.Clip>
                                                            <RectangleGeometry Rect="0,0,40,40" RadiusX="8" RadiusY="8" />
                                                        </Image.Clip>
                                                    </Image>
                                                </Grid>
                                            </Border>
                                        </Grid>

                                        <Separator Margin="0,2,0,6" Style="{StaticResource MenuSeparatorStyle}" />

                                        <!-- 1. 立即同步 -->
                                        <Button x:Name="AccountPopupPrimaryButton"
                                                Style="{StaticResource AccountPopupItemButtonStyle}"
                                                Click="OnAccountPopupPrimaryClick">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontFamily="Segoe Fluent Icons" FontSize="16"
                                                           Text="&#xE895;" VerticalAlignment="Center" />
                                                <TextBlock x:Name="AccountPrimaryText" Grid.Column="1"
                                                           Text="立即同步" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>

                                        <!-- 2. 导入 -->
                                        <Button Style="{StaticResource AccountPopupItemButtonStyle}"
                                                ToolTip="导入笔记文件或备份"
                                                Click="OnAccountPopupImportClick">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Viewbox Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Canvas Width="16" Height="16">
                                                        <Path Stroke="{DynamicResource TextBrush}" StrokeThickness="1.1"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"
                                                              Data="M 1.5,11 L 1.5,15 L 14.5,15 L 14.5,11 M 8,0.5 L 8,10.5 M 4.5,7 L 8,10.5 L 11.5,7" />
                                                    </Canvas>
                                                </Viewbox>
                                                <TextBlock Grid.Column="1" Text="导入" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>

                                        <!-- 3. 导出 -->
                                        <Button Style="{StaticResource AccountPopupItemButtonStyle}"
                                                ToolTip="导出当前笔记"
                                                Click="OnAccountPopupExportClick">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Viewbox Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Canvas Width="16" Height="16">
                                                        <Path Stroke="{DynamicResource TextBrush}" StrokeThickness="1.1"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"
                                                              Data="M 1.5,11 L 1.5,15 L 14.5,15 L 14.5,11 M 8,10.5 L 8,0.5 M 4.5,4 L 8,0.5 L 11.5,4" />
                                                    </Canvas>
                                                </Viewbox>
                                                <TextBlock Grid.Column="1" Text="导出" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>

                                        <!-- 4. 开机自启动 -->
                                        <Button Style="{StaticResource AccountPopupItemButtonStyle}"
                                                Click="OnAutoStartClick">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontFamily="Segoe Fluent Icons" FontSize="16"
                                                           Text="&#xE7E8;" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="开机自启动" VerticalAlignment="Center" />
                                                <TextBlock x:Name="AutoStartCheckMark" Grid.Column="2" FontFamily="Segoe Fluent Icons"
                                                           FontSize="14" Foreground="{DynamicResource AccentBrush}" Text="&#xE73E;" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>

                                        <!-- 5. 颜色模式 -->
                                        <Button x:Name="ThemeModeButton"
                                                Style="{StaticResource AccountPopupItemButtonStyle}"
                                                Click="OnThemeModeClick">
                                            <Button.ContextMenu>
                                                <ContextMenu x:Name="AccountThemeMenu"
                                                             Style="{StaticResource AccountThemeMenuStyle}">
                                                    <MenuItem x:Name="ThemeSystemMenuItem" Header="跟随系统" Tag="system"
                                                              IsCheckable="True" Click="OnAccountThemeOptionClick" />
                                                    <MenuItem x:Name="ThemeLightMenuItem" Header="浅色" Tag="light"
                                                              IsCheckable="True" Click="OnAccountThemeOptionClick" />
                                                    <MenuItem x:Name="ThemeDarkMenuItem" Header="深色" Tag="dark"
                                                              IsCheckable="True" Click="OnAccountThemeOptionClick" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="18" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontFamily="Segoe Fluent Icons" FontSize="16"
                                                           Text="&#xE708;" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="颜色模式" VerticalAlignment="Center" />
                                                <TextBlock x:Name="AccountThemeCurrentText" Grid.Column="2"
                                                           Margin="8,0,4,0" Foreground="{DynamicResource MutedTextBrush}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" FontFamily="Segoe Fluent Icons" FontSize="12"
                                                           Text="&#xE76C;" HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>

                                        <!-- 6. 设置 -->
                                        <Button Style="{StaticResource AccountPopupItemButtonStyle}"
                                                Click="OnAccountPopupSettingsClick">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontFamily="Segoe Fluent Icons" FontSize="16"
                                                           Text="&#xE713;" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="设置" VerticalAlignment="Center" />
                                                <TextBlock x:Name="AccountSettingsVersionText" Grid.Column="2"
                                                           Foreground="{DynamicResource MutedTextBrush}" />
                                            </Grid>
                                        </Button>

                                        <!-- 7. 退出账号 -->
                                        <Separator x:Name="AccountSignOutSeparator" Margin="0,4"
                                                   Style="{StaticResource MenuSeparatorStyle}" />
                                        <Button x:Name="AccountPopupSignOutButton"
                                                Style="{StaticResource AccountPopupItemButtonStyle}"
                                                Click="OnAccountPopupSignOutClick">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontFamily="Segoe Fluent Icons" FontSize="16"
                                                           Text="&#xF3B1;" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="退出账号"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>

                                        <!-- 8. 底部同步状态卡片 -->
                                        <Border x:Name="AccountPopupSyncCard" Margin="2,8,2,2" Padding="12,10"
                                                Background="{DynamicResource SecondaryPanelBrush}" CornerRadius="8">
                                            <StackPanel>
                                                <TextBlock x:Name="AccountPopupSyncStatsText" Text="已同步： 上传 0，更新 0"
                                                           FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
                                                <TextBlock x:Name="AccountPopupLastSyncTimeText" Margin="0,3,0,0" Text="上次同步： 刚刚"
                                                           FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ListBox x:Name="NotebookList" ItemsSource="{Binding Notebooks}"
                             SelectedItem="{Binding SelectedNotebook}" BorderThickness="0"
                             Background="Transparent" FontSize="14">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnNotebookPreviewMouseRightButtonDown" />
                                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnNotebookPreviewMouseLeftButtonDown" />
                                <EventSetter Event="PreviewMouseMove" Handler="OnNotebookPreviewMouseMove" />
                                <EventSetter Event="DragOver" Handler="OnNotebookDragOver" />
                                <EventSetter Event="DragLeave" Handler="OnNotebookDragLeave" />
                                <EventSetter Event="Drop" Handler="OnNotebookDrop" />
                                <Setter Property="AllowDrop" Value="True" />
                                <Setter Property="Padding" Value="7,6" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Grid SnapsToDevicePixels="True">
                                                <Border x:Name="ItemBackground"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="Transparent"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}"
                                                        SnapsToDevicePixels="True">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                </Border>
                                                <Border x:Name="TopLineIndicator" Height="2" Background="{DynamicResource AccentBrush}"
                                                        VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="8,-1,8,0"
                                                        CornerRadius="1" Visibility="Collapsed" IsHitTestVisible="False" />
                                                <Border x:Name="BottomLineIndicator" Height="2" Background="{DynamicResource AccentBrush}"
                                                        VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="8,0,8,-1"
                                                        CornerRadius="1" Visibility="Collapsed" IsHitTestVisible="False" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBackground" Property="Background"
                                                            Value="{DynamicResource SecondaryPanelBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBackground" Property="Background"
                                                            Value="{DynamicResource AccentLightBrush}" />
                                                    <Setter TargetName="ItemBackground" Property="BorderBrush"
                                                            Value="{DynamicResource AccentBrush}" />
                                                </Trigger>
                                                <Trigger Property="local:DropHelper.Indicator" Value="Highlight">
                                                    <Setter TargetName="ItemBackground" Property="Background"
                                                            Value="{DynamicResource AccentLightBrush}" />
                                                    <Setter TargetName="ItemBackground" Property="BorderBrush"
                                                            Value="{DynamicResource AccentBrush}" />
                                                </Trigger>
                                                <Trigger Property="local:DropHelper.Indicator" Value="TopLine">
                                                    <Setter TargetName="TopLineIndicator" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                                <Trigger Property="local:DropHelper.Indicator" Value="BottomLine">
                                                    <Setter TargetName="BottomLineIndicator" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="{Binding IndentMargin}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Path Width="20" Height="20" Data="{Binding IconData}"
                                              Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.45"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" Fill="Transparent" Stretch="Uniform" />
                                    </Viewbox>
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" Style="{StaticResource PaneGridSplitterStyle}"
                          Background="{DynamicResource SecondaryPanelBrush}"
                          DragCompleted="OnPaneSplitterDragCompleted" />
            <Border Grid.Column="2" Background="{DynamicResource PanelBrush}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="14,12" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel>
                            <Border CornerRadius="6" Background="{DynamicResource SecondaryPanelBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <TextBox x:Name="SearchBox" Margin="10,7" BorderThickness="0" Background="Transparent"
                                             FontSize="14" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="搜索标题和正文（Ctrl+F）" />
                                    <TextBlock Margin="12,0" Text="搜索标题和正文" VerticalAlignment="Center"
                                               Foreground="{DynamicResource MutedTextBrush}" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                            <TextBlock Margin="2,12,0,0" Text="{Binding NotesHeading}" FontSize="16" FontWeight="Normal" />
                        </StackPanel>
                    </Border>
                    <Button DockPanel.Dock="Bottom" Margin="14,8" Padding="12,7"
                            Content="加载更多笔记" Command="{Binding LoadMoreCommand}"
                            Visibility="{Binding HasMoreNotes, Converter={StaticResource BooleanToVisibilityConverter}}"
                            AutomationProperties.Name="加载更多笔记" />
                    <Grid>
                        <ListBox ItemsSource="{Binding Notes}" SelectedItem="{Binding SelectedNote}"
                                 BorderThickness="0" Background="{DynamicResource PanelBrush}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.PanningMode="VerticalOnly"
                                 ScrollViewer.IsDeferredScrollingEnabled="False"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 VirtualizingPanel.CacheLength="2,2"
                                 VirtualizingPanel.CacheLengthUnit="Page"
                                 UseLayoutRounding="True" SnapsToDevicePixels="True">
                            <ListBox.Resources>
                                <Style TargetType="ScrollBar"
                                       BasedOn="{StaticResource SlimVerticalScrollBarStyle}" />
                            </ListBox.Resources>
                             <ListBox.ItemContainerStyle>
                                 <Style TargetType="ListBoxItem">
                                     <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnNotePreviewMouseRightButtonDown" />
                                     <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnNotePreviewMouseLeftButtonDown" />
                                     <EventSetter Event="PreviewMouseMove" Handler="OnNotePreviewMouseMove" />
                                     <EventSetter Event="MouseDoubleClick" Handler="OnNoteMouseDoubleClick" />
                                     <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                     <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                     <Setter Property="Margin" Value="6,0" />
                                     <Setter Property="Padding" Value="0" />
                                     <Setter Property="Background" Value="Transparent" />
                                     <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                     <Setter Property="BorderThickness" Value="0" />
                                     <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                     <Setter Property="SnapsToDevicePixels" Value="True" />
                                     <Setter Property="Template">
                                         <Setter.Value>
                                             <ControlTemplate TargetType="ListBoxItem">
                                                 <Border x:Name="ItemBackground"
                                                         Background="{TemplateBinding Background}"
                                                         BorderBrush="Transparent"
                                                         BorderThickness="1"
                                                         CornerRadius="6"
                                                         Margin="0,-1"
                                                         SnapsToDevicePixels="True">
                                                     <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                 </Border>
                                                 <ControlTemplate.Triggers>
                                                     <Trigger Property="IsMouseOver" Value="True">
                                                         <Setter TargetName="ItemBackground" Property="Background"
                                                                 Value="{DynamicResource SecondaryPanelBrush}" />
                                                     </Trigger>
                                                     <Trigger Property="IsSelected" Value="True">
                                                         <Setter TargetName="ItemBackground" Property="Background"
                                                                 Value="{DynamicResource AccentLightBrush}" />
                                                         <Setter TargetName="ItemBackground" Property="BorderBrush"
                                                                 Value="{DynamicResource AccentBrush}" />
                                                     </Trigger>
                                                 </ControlTemplate.Triggers>
                                             </ControlTemplate>
                                         </Setter.Value>
                                     </Setter>
                                 </Style>
                             </ListBox.ItemContainerStyle>
                             <ListBox.ItemTemplate>
                                 <DataTemplate>
                                     <Grid>
                                         <StackPanel Margin="10,10">
                                             <local:HighlightedTextBlock HighlightText="{Binding TitleDisplay}"
                                                                        HighlightQuery="{Binding MatchQuery}"
                                                                        FontSize="15" FontWeight="Normal"
                                                                        TextTrimming="CharacterEllipsis" />
                                            <local:HighlightedTextBlock Margin="0,5,0,0"
                                                                        HighlightText="{Binding Preview}"
                                                                        HighlightQuery="{Binding MatchQuery}"
                                                                        Foreground="{DynamicResource MutedTextBrush}"
                                                                        FontSize="14"
                                                                        TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                                        LineHeight="18" MaxHeight="72" />
                                             <TextBlock Margin="0,2,0,0" Text="{Binding UpdatedLabel}" FontSize="12"
                                                        Foreground="{DynamicResource MutedTextBrush}" />
                                         </StackPanel>
                                         <Viewbox Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                  Margin="0,10,10,0" ToolTip="未同步到云端"
                                                  Visibility="{Binding IsUnsynced, Converter={StaticResource BooleanToVisibilityConverter}}">
                                             <Canvas Width="24" Height="24">
                                                 <Path Stroke="#10B981" StrokeThickness="1.8" StrokeLineJoin="Round"
                                                       StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                       Data="M 6 19 A 4 4 0 0 1 5 11 A 5.5 5.5 0 0 1 15 8 A 4.5 4.5 0 0 1 19 14 A 3.5 3.5 0 0 1 17 19 M 12 18 L 12 11 M 9 14 L 12 11 L 15 14" />
                                             </Canvas>
                                         </Viewbox>
                                         <Border Height="1" Margin="6,0" VerticalAlignment="Bottom"
                                                 Background="{DynamicResource BorderBrush}" />
                                     </Grid>
                                 </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border Background="{DynamicResource PanelBrush}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasNotes}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="这里还没有笔记" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Margin="0,6,0,12" Text="创建一篇笔记开始记录" Foreground="{DynamicResource MutedTextBrush}" />
                                <Button Content="新建笔记" Command="{Binding NewNoteCommand}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="3" Style="{StaticResource PaneGridSplitterStyle}"
                          DragCompleted="OnPaneSplitterDragCompleted" />
            <Grid Grid.Column="4" Background="{DynamicResource PanelBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Padding="10,6" Background="Transparent"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                        IsEnabled="{Binding IsEditorEnabled}"
                        KeyboardNavigation.TabNavigation="None">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="FontFamilyBox" Width="130" Height="30" MinHeight="0" Margin="3,0"
                                      Style="{StaticResource ToolbarComboBoxStyle}"
                                      SelectedIndex="0" SelectionChanged="OnEditorFontFamilyChanged"
                                      ToolTip="字体">
                                <ComboBoxItem Content="微软雅黑" Tag="Microsoft YaHei" />
                                <ComboBoxItem Content="宋体" Tag="SimSun" />
                                <ComboBoxItem Content="黑体" Tag="SimHei" />
                            </ComboBox>
                            <ComboBox x:Name="FontSizeBox" Width="56" Height="30" MinHeight="0" Margin="1,0,3,0"
                                      Style="{StaticResource ToolbarComboBoxStyle}"
                                      SelectedIndex="0" SelectionChanged="OnEditorFontSizeChanged"
                                      ToolTip="字号">
                                <ComboBoxItem Content="12" Tag="12" />
                                <ComboBoxItem Content="14" Tag="14" />
                                <ComboBoxItem Content="16" Tag="16" />
                                <ComboBoxItem Content="18" Tag="18" />
                                <ComboBoxItem Content="24" Tag="24" />
                                <ComboBoxItem Content="32" Tag="32" />
                            </ComboBox>
                            <Button x:Name="ParagraphButton" Width="44" Content="正文" Tag="paragraph"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Click="OnEditorCommandClick" ToolTip="正文" />
                            <Button x:Name="Heading1Button" Content="H₁" Tag="heading1"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Click="OnEditorCommandClick" ToolTip="一级标题" />
                            <Button x:Name="Heading2Button" Content="H₂" Tag="heading2"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Click="OnEditorCommandClick" ToolTip="二级标题" />
                            <Separator Margin="5,0" />
                            <Button x:Name="BoldButton" Content="B" FontWeight="Bold" Tag="bold"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Click="OnEditorCommandClick" ToolTip="粗体" />
                            <Button x:Name="ItalicButton" Content="I" FontStyle="Italic" Tag="italic"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Click="OnEditorCommandClick" ToolTip="斜体" />
                            <Button x:Name="UnderlineButton" Tag="underline"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Click="OnEditorCommandClick" ToolTip="下划线（Ctrl+U）">
                                <TextBlock Text="U" TextDecorations="Underline" />
                            </Button>
                            <Button x:Name="StrikeButton" Tag="strike"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Click="OnEditorCommandClick" ToolTip="删除线">
                                <TextBlock Text="ab" TextDecorations="Strikethrough" />
                            </Button>
                            <Button x:Name="HighlightButton" Tag="highlight"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Click="OnEditorCommandClick" ToolTip="文字高亮">
                                <Grid>
                                    <TextBlock Text="ab" VerticalAlignment="Center" />
                                    <Border Height="4" Margin="1,0" Background="#FFFFD633"
                                            VerticalAlignment="Bottom" />
                                </Grid>
                            </Button>
                            <Button x:Name="FormulaButton" Tag="inlineMath"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Click="OnEditorCommandClick" ToolTip="数学公式（Ctrl+M）">
                                <TextBlock Text="fx" FontFamily="Segoe UI" FontWeight="SemiBold" FontStyle="Italic" FontSize="13" />
                            </Button>
                            <Separator Margin="5,0" />
                            <Button x:Name="BulletListButton" Content="•☰" Tag="bulletList"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Click="OnEditorCommandClick" ToolTip="项目符号列表" />
                            <Button x:Name="OrderedListButton" Content="1☰" Tag="orderedList"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Click="OnEditorCommandClick" ToolTip="编号列表" />
                            <Button x:Name="QuoteButton" Content="❞" Tag="blockquote"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Click="OnEditorCommandClick" ToolTip="引用" />
                            <Button x:Name="CodeBlockButton" Content="{}{ }" Tag="codeBlock"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Click="OnEditorCommandClick" ToolTip="代码块" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                <Border Grid.Row="1" Padding="24,14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <StackPanel IsEnabled="{Binding IsEditorEnabled}">
                        <TextBox x:Name="TitleBox"
                                 Text="{Binding EditableTitle, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="22" FontWeight="SemiBold" BorderThickness="0" Padding="0"
                                 Background="Transparent" TextWrapping="NoWrap"
                                 PreviewKeyDown="OnTitlePreviewKeyDown" />
                        <TextBlock Margin="0,6,0,0" Text="{Binding SelectedTagsDisplay}"
                                    Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Margin="18,10,18,18" BorderThickness="0" Background="Transparent">
                    <Grid x:Name="EditorWebViewHost">
                        <wv2:WebView2 x:Name="EditorWebView" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
    </Border>
</Window>
