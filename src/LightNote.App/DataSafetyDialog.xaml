<Window x:Class="LightNote.App.DataSafetyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="数据安全中心"
        Width="760"
        Height="520"
        MinWidth="540"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="数据安全中心" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Margin="0,5,0,0" Text="集中查看同步、冲突、备份与本地数据完整性。"
                       Foreground="#FF68707A" />
        </StackPanel>

        <UniformGrid Grid.Row="1" Margin="0,18,0,14" Columns="3">
            <Border Margin="0,0,8,0" Padding="14" CornerRadius="8" Background="#0F4472C4">
                <StackPanel>
                    <TextBlock Text="同步状态" Foreground="#FF68707A" />
                    <TextBlock x:Name="SyncStatusText" Margin="0,6,0,0" FontWeight="SemiBold"
                               TextWrapping="Wrap" AutomationProperties.Name="当前同步状态" />
                </StackPanel>
            </Border>
            <Border Margin="4,0" Padding="14" CornerRadius="8" Background="#0F4472C4">
                <StackPanel>
                    <TextBlock Text="待同步项目" Foreground="#FF68707A" />
                    <TextBlock x:Name="PendingCountText" Margin="0,6,0,0" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Margin="8,0,0,0" Padding="14" CornerRadius="8" Background="#0F4472C4">
                <StackPanel>
                    <TextBlock Text="冲突副本" Foreground="#FF68707A" />
                    <TextBlock x:Name="ConflictCountText" Margin="0,6,0,0" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Padding="14" CornerRadius="8" BorderBrush="#334472C4" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="本地完整性" FontWeight="SemiBold" />
                    <TextBlock x:Name="IntegrityStatusText" Margin="0,5,0,0" Text="尚未检查" />
                    <TextBlock x:Name="BackupStatusText" Margin="0,5,0,0" Foreground="#FF68707A" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Padding="14,7" Content="立即检查" Click="OnCheckClick"
                        AutomationProperties.Name="检查数据库和附件完整性" />
            </Grid>
        </Border>

        <TextBox x:Name="DetailsText" Grid.Row="3" Margin="0,14,0,0" Padding="10"
                 IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="数据安全检查详情" />

        <WrapPanel Grid.Row="4" Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Padding="12,7" Content="验证最近备份" Click="OnValidateBackupClick"
                    AutomationProperties.Name="验证最近一份备份" />
            <Button Padding="12,7" Content="打开备份目录" Click="OnOpenBackupsClick" />
            <Button Padding="12,7" Content="打开日志目录" Click="OnOpenLogsClick" />
            <Button Padding="12,7" Content="生成脱敏诊断报告" Click="OnCreateDiagnosticClick"
                    ToolTip="报告不包含笔记正文、Firebase 配置或登录令牌" />
            <Button Margin="12,0,0,0" Padding="18,7" Content="关闭" IsCancel="True" />
        </WrapPanel>
    </Grid>
</Window>
