<Window x:Class="LightNote.App.ImportSourceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导入笔记"
        Width="470"
        Height="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="从现有文件导入" FontSize="19" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Margin="0,8,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource MutedTextBrush}"
                   Text="自动识别常见导出格式，并转换成可编辑、可搜索的本地笔记。" />
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Margin="0" Padding="16" Click="OnFilesClick"
                    AutomationProperties.Name="选择一个或多个笔记文件">
                <StackPanel>
                    <TextBlock Text="选择文件" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Margin="0,7,0,0" Text="可一次选择多个文件" Foreground="{DynamicResource MutedTextBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Margin="0" Padding="16" Click="OnFolderClick"
                    AutomationProperties.Name="递归导入笔记文件夹">
                <StackPanel>
                    <TextBlock Text="选择文件夹" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Margin="0,7,0,0" Text="递归导入并保留子目录" Foreground="{DynamicResource MutedTextBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,18,0,0">
            <Border Padding="12" CornerRadius="6" Background="{DynamicResource SidebarBrush}">
                <StackPanel>
                    <TextBlock Text="迁移兼容" FontWeight="SemiBold" />
                    <TextBlock Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                               Text="印象笔记 / 有道云：ENEX 或 HTML&#x0a;Google Keep：解压 Google Takeout 后选择 Keep 文件夹&#x0a;浮墨、为知、WPS、小米及其他软件：HTML、Markdown、TXT 或 CSV" />
                </StackPanel>
            </Border>
            <Button Margin="0,12,0,0" HorizontalAlignment="Right" Padding="18,7" Content="取消" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
