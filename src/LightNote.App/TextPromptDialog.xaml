<Window x:Class="LightNote.App.TextPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="22,20,22,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptText" FontSize="14" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" LineHeight="20" />
        <TextBox x:Name="ValueTextBox" Grid.Row="1" Margin="0,14,0,18" Padding="10,7"
                 FontSize="14" MaxLength="80" />
        <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,4,0,0">
            <Button Content="取消" IsCancel="True" Style="{DynamicResource DialogButtonStyle}" />
            <Button Content="确定" IsDefault="True" Click="OnAcceptClick"
                    Style="{DynamicResource DialogPrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
