<UserControl x:Class="LightNote.App.WindowTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="48" Focusable="False">
    <!-- The right-hand caption buttons are drawn and handled by Windows App SDK. -->
    <Border Background="{DynamicResource SecondaryPanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftCaptionInset" Width="0" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="RightCaptionInset" Width="138" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="1" Margin="12,0,12,0" IsHitTestVisible="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Width="22" Height="22" Source="{DynamicResource AppIconImage}" />
                <TextBlock x:Name="CaptionText" Grid.Column="1" Margin="8,0,0,0" FontSize="13"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextBrush}"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
