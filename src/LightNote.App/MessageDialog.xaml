<Window x:Class="LightNote.App.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LightNote.App"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        Icon="Assets/pen-note-icon-green.ico"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" WindowStyle="SingleBorderWindow"
        FontFamily="Microsoft YaHei" Foreground="{DynamicResource TextBrush}"
        Background="{DynamicResource AppBackgroundBrush}"
        PreviewKeyDown="OnPreviewKeyDown">
    <Border Background="{DynamicResource AppBackgroundBrush}"
            BorderThickness="0"
            SnapsToDevicePixels="True">
        <DockPanel>
            <local:WindowTitleBar DockPanel.Dock="Top" ShowMinMax="False" />
            <Grid Margin="22,20,22,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="SymbolPanel" Width="32" Height="32" Margin="0,0,14,0"
                                VerticalAlignment="Top" CornerRadius="16"
                                Background="{DynamicResource SecondaryPanelBrush}">
                            <TextBlock x:Name="SymbolText" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="MessageText" Grid.Column="1" FontSize="14" LineHeight="22"
                                   Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                    </Grid>
                </ScrollViewer>
                <StackPanel x:Name="ButtonPanel" Grid.Row="1" Margin="0,22,0,0"
                            Orientation="Horizontal" HorizontalAlignment="Right" />
            </Grid>
        </DockPanel>
    </Border>
</Window>
