<Window x:Class="LightNote.App.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LightNote.App"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="LightNote 设置"
        Width="940"
        Height="650"
        MinWidth="760"
        MinHeight="540"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowStyle="None"
        Background="{DynamicResource AppBackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="8" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="SettingsNavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="NavBorder" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background"
                                        Value="{DynamicResource SecondaryPanelBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NavBorder" Property="Background"
                                        Value="{DynamicResource AccentLightBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="PageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="PageDescriptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,20" />
        </Style>
        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style x:Key="CardDescriptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SettingsActionButtonStyle" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="100" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <local:WindowTitleBar />
        <Border Grid.Row="1" Padding="24,17" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel>
                    <TextBlock Text="设置" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Margin="0,3,0,0" Text="管理导入、导出、备份与数据安全"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="LightNote" FontSize="16" FontWeight="Normal"
                               Foreground="{DynamicResource TextBrush}" TextAlignment="Right" />
                    <TextBlock x:Name="VersionText" Margin="0,2,0,0" FontSize="14" FontWeight="Normal"
                               Foreground="{DynamicResource MutedTextBrush}" TextAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Padding="16,18" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <ListBox x:Name="NavigationList" BorderThickness="0" Background="Transparent"
                         ItemContainerStyle="{StaticResource SettingsNavItemStyle}"
                         SelectionChanged="OnNavigationSelectionChanged">
                    <ListBoxItem Content="导入与导出" Tag="import-export" />
                    <ListBoxItem Content="备份" Tag="backup" />
                    <ListBoxItem Content="数据安全" Tag="safety" />
                </ListBox>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="28,24">
                <Grid>
                    <StackPanel x:Name="ImportExportPage" Visibility="Collapsed">
                        <TextBlock Text="导入与导出" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="导入其他应用的数据，或将当前笔记导出为通用文件。"
                                   Style="{StaticResource PageDescriptionStyle}" />
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="导入笔记" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock Margin="0,4,12,0" Text="从 ENEX、Google Keep、CSV、Markdown、文本或 HTML 迁移内容。"
                                               Style="{StaticResource CardDescriptionStyle}" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource SettingsActionButtonStyle}"
                                        Content="选择来源" Click="OnImportRequestClick" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="导出当前笔记" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock Margin="0,4,12,0" Text="将当前笔记保存为 HTML、Markdown 或纯文本。"
                                               Style="{StaticResource CardDescriptionStyle}" />
                                </StackPanel>
                                <Button x:Name="ExportNoteButton" Grid.Column="1"
                                        Style="{StaticResource SettingsActionButtonStyle}"
                                        Content="导出" Click="OnExportRequestClick" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="BackupPage" Visibility="Collapsed">
                        <TextBlock Text="备份" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="创建、恢复并安排本地完整备份。"
                                   Style="{StaticResource PageDescriptionStyle}" />
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="创建完整备份" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock Margin="0,4,12,0" Text="备份数据库、附件和恢复所需的完整性信息。"
                                               Style="{StaticResource CardDescriptionStyle}" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource SettingsActionButtonStyle}"
                                        Content="立即备份" Click="OnBackupRequestClick" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="恢复完整备份" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock Margin="0,4,12,0" Text="验证备份后恢复到单独目录，不会直接覆盖当前资料。"
                                               Style="{StaticResource CardDescriptionStyle}" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource SettingsActionButtonStyle}"
                                        Content="恢复" Click="OnRestoreRequestClick" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="自动备份" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Margin="0,4,0,10" Text="安排本地数据库与附件的定期备份。"
                                           Style="{StaticResource CardDescriptionStyle}" />
                                <CheckBox x:Name="AutomaticBackupsBox" Content="每天自动备份数据库和附件" FontSize="13" />
                                <StackPanel Margin="22,10,0,0" Orientation="Horizontal">
                                    <TextBlock Text="保留份数" FontSize="13" VerticalAlignment="Center" />
                                    <TextBox x:Name="RetentionBox" Width="64" Margin="10,0,0,0" Padding="6,4" FontSize="13" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="备份设置保存在本机，不会同步到 Firebase。"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>

                    <StackPanel x:Name="SafetyPage" Visibility="Collapsed">
                        <TextBlock Text="数据安全" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="查看同步队列、冲突、备份状态和本地数据库完整性。"
                                   Style="{StaticResource PageDescriptionStyle}" />
                        <UniformGrid Columns="3" Margin="0,0,0,12">
                            <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="同步状态" Style="{StaticResource CardDescriptionStyle}" />
                                    <TextBlock x:Name="SyncStatusText" Margin="0,6,0,0" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}" Margin="4,0">
                                <StackPanel>
                                    <TextBlock Text="待同步项目" Style="{StaticResource CardDescriptionStyle}" />
                                    <TextBlock x:Name="PendingCountText" Margin="0,6,0,0" FontSize="18" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="冲突副本" Style="{StaticResource CardDescriptionStyle}" />
                                    <TextBlock x:Name="ConflictCountText" Margin="0,6,0,0" FontSize="18" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="本地完整性" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock x:Name="IntegrityStatusText" Margin="0,5,0,0" FontSize="13" Text="尚未检查" />
                                    <TextBlock x:Name="BackupStatusText" Margin="0,5,12,0"
                                               Style="{StaticResource CardDescriptionStyle}" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource SettingsActionButtonStyle}"
                                        Content="立即检查" Click="OnCheckClick" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="数据库与系统详情" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Margin="0,4,0,8" Text="数据库版本、文件大小、备份位置及检查诊断信息。"
                                           Style="{StaticResource CardDescriptionStyle}" />
                                <TextBox x:Name="DetailsText" MinHeight="84" Padding="10" IsReadOnly="True"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         FontFamily="Microsoft YaHei" FontSize="13"
                                         Background="{DynamicResource SecondaryPanelBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
                            </StackPanel>
                        </Border>
                        <WrapPanel Margin="0,4,0,0" HorizontalAlignment="Right">
                            <Button Content="验证最近备份" Click="OnValidateBackupClick" />
                            <Button Content="打开备份目录" Click="OnOpenBackupsClick" />
                            <Button Content="打开日志目录" Click="OnOpenLogsClick" />
                            <Button Content="生成脱敏诊断报告" Click="OnCreateDiagnosticClick"
                                    ToolTip="报告不包含笔记正文、Firebase 配置或登录令牌" />
                        </WrapPanel>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="3" Padding="18,12" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Margin="0,0,8,0" Padding="18,7" Content="取消" IsCancel="True" />
                <Button Padding="18,7" Content="保存" IsDefault="True" Click="OnSaveClick" />
            </StackPanel>
        </Border>
    </Grid>
    </Border>
</Window>
