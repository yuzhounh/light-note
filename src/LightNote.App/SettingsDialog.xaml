<Window x:Class="LightNote.App.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LightNote 设置"
        Width="450"
        Height="390"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="日常使用" FontSize="18" FontWeight="SemiBold" />
        <StackPanel Grid.Row="1" Margin="0,18,0,0">
            <TextBlock Text="主题" />
            <ComboBox x:Name="ThemeBox" Margin="0,6,0,0" SelectedValuePath="Tag">
                <ComboBoxItem Content="跟随系统" Tag="system" />
                <ComboBoxItem Content="浅色" Tag="light" />
                <ComboBoxItem Content="深色" Tag="dark" />
            </ComboBox>
        </StackPanel>
        <CheckBox x:Name="MinimizeToTrayBox" Grid.Row="2" Margin="0,16,0,0"
                  Content="关闭窗口时最小化到系统托盘" />
        <CheckBox x:Name="StartWithWindowsBox" Grid.Row="3" Margin="0,12,0,0"
                  Content="登录 Windows 后自动启动" />
        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <CheckBox x:Name="AutomaticBackupsBox" Content="每天自动备份数据库和附件" />
            <StackPanel Margin="22,10,0,0" Orientation="Horizontal">
                <TextBlock Text="保留份数" VerticalAlignment="Center" />
                <TextBox x:Name="RetentionBox" Width="56" Margin="10,0,0,0" Padding="6,4" />
            </StackPanel>
        </StackPanel>
        <TextBlock Grid.Row="5" Margin="0,18,0,0" Text="设置保存在本机，不会同步到 Firebase。"
                   Foreground="{DynamicResource MutedTextBrush}" />
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Margin="0,0,8,0" Padding="16,7" Content="取消" IsCancel="True" />
            <Button Padding="16,7" Content="保存" IsDefault="True" Click="OnSaveClick" />
        </StackPanel>
    </Grid>
</Window>
