<Window x:Class="LightNote.App.HistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="历史版本"
        Width="1080"
        Height="680"
        MinWidth="840"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimVerticalScrollBarStyle}" />
        <Style x:Key="HistoryBodyTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="0,0,2,8"
                                      Padding="12,0,8,0"
                                      Focusable="False" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="历史与冲突对比" FontSize="17" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextBrush}" />
        <Grid Grid.Row="1" Margin="0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <GroupBox Header="版本列表" Padding="2">
                <ListBox x:Name="VersionsList" ItemsSource="{Binding}" SelectionChanged="OnSelectionChanged"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="历史版本列表">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="4,2" />
                        <Setter Property="Padding" Value="6,4" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBorder" Background="Transparent"
                                            BorderBrush="Transparent" BorderThickness="1" CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background"
                                                    Value="{DynamicResource SecondaryPanelBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background"
                                                    Value="{DynamicResource ListItemSelectedBackgroundBrush}" />
                                            <Setter TargetName="ItemBorder" Property="BorderBrush"
                                                    Value="{DynamicResource ListItemSelectedBorderBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="6">
                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}">
                                <Run Text="版本 " /><Run Text="{Binding Version, Mode=OneWay}" /><Run Text=" · " />
                                <Run Text="{Binding CreatedLabel, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Margin="0,5,0,0" Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextBrush}" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding Preview}" Foreground="{DynamicResource MutedTextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            </GroupBox>
            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <GroupBox Header="当前版本" Padding="0">
                    <DockPanel LastChildFill="True">
                        <TextBlock x:Name="CurrentTitleText" DockPanel.Dock="Top" Margin="12,12,12,8"
                                   FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
                        <TextBox x:Name="CurrentBodyText" IsReadOnly="True" BorderThickness="0"
                                 Background="Transparent" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Style="{StaticResource HistoryBodyTextBoxStyle}" />
                    </DockPanel>
                </GroupBox>
                <GroupBox Grid.Column="2" Header="所选历史版本" Padding="0">
                    <DockPanel LastChildFill="True">
                        <TextBlock x:Name="SelectedTitleText" DockPanel.Dock="Top" Margin="12,12,12,8"
                                   FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
                        <TextBox x:Name="SelectedBodyText" IsReadOnly="True" BorderThickness="0"
                                 Background="Transparent" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Style="{StaticResource HistoryBodyTextBoxStyle}" />
                    </DockPanel>
                </GroupBox>
            </Grid>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Margin="0,0,8,0" Padding="16,7" Content="取消" IsCancel="True"
                    Style="{StaticResource DialogButtonStyle}" />
            <Button Padding="16,7" Content="恢复所选版本" IsDefault="True" Click="OnRestoreClick"
                    Style="{StaticResource DialogPrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
