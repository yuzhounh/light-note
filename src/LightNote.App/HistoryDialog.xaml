<Window x:Class="LightNote.App.HistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="历史版本"
        Width="920"
        Height="560"
        MinWidth="720"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="历史与冲突对比" FontSize="17" FontWeight="SemiBold" />
        <Grid Grid.Row="1" Margin="0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="VersionsList" ItemsSource="{Binding}" SelectionChanged="OnSelectionChanged"
                     AutomationProperties.Name="历史版本列表">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="8">
                            <TextBlock FontWeight="SemiBold">
                                <Run Text="版本 " /><Run Text="{Binding Version, Mode=OneWay}" /><Run Text=" · " />
                                <Run Text="{Binding CreatedLabel, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Margin="0,5,0,0" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding Preview}" Foreground="#FF68707A"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <GroupBox Header="当前版本" Padding="10">
                    <DockPanel>
                        <TextBlock x:Name="CurrentTitleText" DockPanel.Dock="Top" Margin="0,0,0,8"
                                   FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBox x:Name="CurrentBodyText" IsReadOnly="True" BorderThickness="0"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                    </DockPanel>
                </GroupBox>
                <GroupBox Grid.Column="2" Header="所选历史版本" Padding="10">
                    <DockPanel>
                        <TextBlock x:Name="SelectedTitleText" DockPanel.Dock="Top" Margin="0,0,0,8"
                                   FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBox x:Name="SelectedBodyText" IsReadOnly="True" BorderThickness="0"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                    </DockPanel>
                </GroupBox>
            </Grid>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Margin="0,0,8,0" Padding="16,7" Content="取消" IsCancel="True" />
            <Button Padding="16,7" Content="恢复所选版本" IsDefault="True" Click="OnRestoreClick" />
        </StackPanel>
    </Grid>
</Window>
