<Window x:Class="LightNote.App.FirebaseSignInDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="登录 Firebase 同步"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="登录 Firebase 同步" FontSize="18" FontWeight="SemiBold" />

        <!-- Google Sign-In Section -->
        <Border Grid.Row="1" Margin="0,16,0,0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
            <StackPanel>
                <Button x:Name="GoogleSignInButton"
                        Height="40"
                        Background="#FFFFFF"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="OnGoogleSignInClick">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="G" FontWeight="Bold" FontSize="16" Foreground="#4285F4" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="使用 Google 账号登录" FontSize="14" FontWeight="Medium" Foreground="#1E293B" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Google Client ID Configuration (Expanded when needed) -->
                <StackPanel x:Name="GoogleConfigPanel" Margin="0,12,0,0">
                    <TextBlock Text="Google OAuth 客户端 ID (Desktop app)：" FontSize="12" Foreground="#475569" Margin="0,0,0,4" />
                    <TextBox x:Name="GoogleClientIdBox" Padding="8,5" FontSize="12" />
                    <TextBlock Text="请在 Google Cloud 凭据中创建类型为「桌面应用」的客户端 ID" FontSize="11" Foreground="#94A3B8" Margin="0,3,0,6" />

                    <TextBlock Text="客户端密钥 Client Secret (可选)：" FontSize="12" Foreground="#475569" Margin="0,0,0,4" />
                    <PasswordBox x:Name="GoogleClientSecretBox" Padding="8,5" FontSize="12" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Status / Waiting panel -->
        <Border x:Name="ProgressPanel" Grid.Row="2" Margin="0,12,0,0" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="10" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="ProgressText" Text="正在等待浏览器授权…" Foreground="#1D4ED8" FontWeight="Medium" TextWrapping="Wrap" />
                <TextBlock Text="已拉起浏览器，请在 Google 官方页面选择账号并授权。" FontSize="11" Foreground="#3B82F6" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- Divider -->
        <Grid Grid.Row="3" Margin="0,16,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Separator VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock Grid.Column="1" Text="或使用邮箱密码" FontSize="12" Foreground="#94A3B8" />
            <Separator Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0" />
        </Grid>

        <!-- Email & Password Form -->
        <StackPanel Grid.Row="4">
            <TextBlock Text="邮箱" FontSize="12" Foreground="#475569" />
            <TextBox x:Name="EmailBox" Margin="0,4,0,10" Padding="8,6" />
            <TextBlock Text="密码" FontSize="12" Foreground="#475569" />
            <PasswordBox x:Name="PasswordBox" Margin="0,4,0,12" Padding="8,6" />
        </StackPanel>

        <!-- Action Buttons -->
        <Grid Grid.Row="5" Margin="0,6,0,0">
            <TextBlock VerticalAlignment="Center" Text="令牌保存在本机 DPAPI" FontSize="11" Foreground="#94A3B8" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Margin="0,0,8,0" Padding="16,6" Content="取消" IsCancel="True" Click="OnCancelClick" />
                <Button x:Name="EmailSignInButton" Padding="16,6" Content="邮箱登录" Click="OnEmailSignInClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
