<Window x:Class="LightNote.App.FirebaseSignInDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="登录 Firebase 同步"
        Width="420"
        Height="260"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="使用 Firebase 邮箱密码账户登录" FontSize="16" FontWeight="SemiBold" />
        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock Text="邮箱" />
            <TextBox x:Name="EmailBox" Margin="0,5,0,0" Padding="8,6" />
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="密码" />
            <PasswordBox x:Name="PasswordBox" Margin="0,5,0,0" Padding="8,6" />
        </StackPanel>
        <TextBlock Grid.Row="3" Margin="0,10,0,0" Text="登录令牌使用 Windows 用户级加密保存在本机。"
                   Foreground="#FF68707A" TextWrapping="Wrap" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Margin="0,0,8,0" Padding="16,7" Content="取消" IsCancel="True" />
            <Button Padding="16,7" Content="登录" IsDefault="True" Click="OnSignInClick" />
        </StackPanel>
    </Grid>
</Window>
